# LifeGuardianⅡ 環境変数設定
# このファイルを .env にコピーして使用してください
# cp .env.example .env

# ========================================
# 基本設定
# ========================================
NODE_ENV=development
BUILD_TARGET=development

# ========================================
# データベース設定
# ========================================

# Neo4j
NEO4J_PASSWORD=lifeguardian2024

# PostgreSQL
POSTGRES_USER=lifeguardian
POSTGRES_PASSWORD=lifeguardian2024
POSTGRES_DB=lifeguardian

# Redis
REDIS_PASSWORD=lifeguardian2024

# ========================================
# アプリケーション設定
# ========================================

# JWT認証
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# セッション設定
SESSION_SECRET=your-session-secret-change-in-production
SESSION_TIMEOUT=1800000

# ========================================
# 外部サービス設定
# ========================================

# n8n
N8N_USER=admin
N8N_PASSWORD=lifeguardian2024

# メール設定（開発環境ではMailHogを使用）
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# ========================================
# セキュリティ設定
# ========================================

# CORS設定
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# レート制限
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# ログ設定
# ========================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=./logs

# ========================================
# バックアップ設定
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# ========================================
# 開発用設定
# ========================================

# デバッグ
DEBUG=lifeguardian:*
NODE_OPTIONS=--inspect=0.0.0.0:9229

# コマンドオーバーライド（開発用）
BACKEND_COMMAND=npm run dev
FRONTEND_COMMAND=npm start
